# 호스트 nginx가 hajin.xyz/world-cup-manager-tactics-web-challenge/ 프리픽스를 벗겨
# 127.0.0.1:18085 → 이 컨테이너로 프록시. HTTPS는 호스트(Let's Encrypt) 담당이므로
# 컨테이너 안에서는 평문 HTTP만 서빙한다.
:80 {
	root * /srv
	encode gzip
	try_files {path} /index.html
	file_server

	# 리더보드 서버(compose profile: leaderboard). 서버 미기동 시 /api만 502, 코어 앱은 무관.
	handle /api/* {
		reverse_proxy server:8000
	}
}
